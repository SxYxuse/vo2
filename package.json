{
  "name": "vo2",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:mock": "STRAVA_MOCK=1 vp dev",
    "dev:seed": "bun scripts/dev-seed.ts",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "start": "bun run db:migrate && bun run .output/server/index.mjs",
    "start:mock": "bun scripts/heavy.ts vp build && APP_ENV=development STRAVA_MOCK=1 bun run .output/server/index.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "bun scripts/worktree-setup.ts",
    "doctor": "bun scripts/doctor.ts",
    "db:prune": "bun scripts/worktree-prune.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check && j=$(shasum drizzle/meta/_journal.json) && drizzle-kit generate && test \"$j\" = \"$(shasum drizzle/meta/_journal.json)\"",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "strava:subscribe": "bun scripts/strava-subscribe.ts",
    "generate:strava-sdk": "openapi-typescript src/integrations/strava/openapi.json -o src/integrations/strava/strava.types.ts",
    "knip": "knip",
    "jscpd": "jscpd",
    "audit": "bun audit --audit-level=high",
    "lighthouse": "bun scripts/heavy.ts bun scripts/lighthouse.ts",
    "e2e": "bun scripts/e2e.ts",
    "e2e:update": "bun scripts/e2e.ts --update",
    "gate": "vp check && knip && jscpd && bun audit --audit-level=high && vp test run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
