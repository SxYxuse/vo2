{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": ["src/router.tsx", "src/start.ts", "public/sw.js", "scripts/*.ts", "e2e/fixed-clock.ts"],
  "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts"],
  "ignore": [
    "src/components/ui/**",
    "src/components/reui/**",
    "src/integrations/strava/strava.types.ts",
  ],
  "ignoreBinaries": ["shasum", "flock"],
  "rules": {
    "exports": "error",
    "types": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
  },
}
