DATABASE_URL=postgresql://vo2:vo2@localhost:5432/vo2
# Dev-server port, bound strictly. BETTER_AUTH_URL must name the same port.
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-vp-dlx-better-auth-cli-secret

# Required unless STRAVA_MOCK=1. Create an app at https://www.strava.com/settings/api
# Authorization Callback Domain: localhost
# Callback URL Better Auth will use: http://localhost:3000/api/auth/callback/strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional. Random string naming the private URL Strava pushes events to, so an athlete who
# revokes VO2 or deletes an activity on Strava is removed here too. After setting it, run
# `vp run strava:subscribe` once per Strava app. Unset turns the webhook off.
STRAVA_WEBHOOK_SECRET=

# Local mock Strava for agents and UI work: OAuth and the API are served by the app
# itself at /api/mock-strava, so no Strava app or account is needed and strava.com is
# never called. Ignored when APP_ENV/NODE_ENV is production. On by default because new
# worktrees copy this file and `db:migrate` rejects empty Strava credentials without it.
# Remove it once STRAVA_CLIENT_ID and STRAVA_CLIENT_SECRET are set to use real Strava.
STRAVA_MOCK=1

# Dev server only: shows the TanStack devtools button. Off by default because it covers Send on
# phones in screenshots and recordings.
# VITE_DEVTOOLS=1

# Logging. APP_ENV defaults to NODE_ENV. Without LOKI_HOST, logs go to the console.
# Non-production envs get their own tile colour: development grey, staging orange, preview blue.
APP_ENV=development
# LOKI_HOST=http://localhost:3100
