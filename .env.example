DATABASE_URL=postgresql://vo:vo@localhost:5432/vo
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-vp-dlx-better-auth-cli-secret

# Required unless STRAVA_MOCK=1. Create an app at https://www.strava.com/settings/api
# Authorization Callback Domain: localhost
# Callback URL Better Auth will use: http://localhost:3000/api/auth/callback/strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Local mock Strava for agents and UI work: OAuth and the API are served by the app
# itself at /api/mock-strava, so no Strava app or account is needed and strava.com is
# never called. Ignored when APP_ENV/NODE_ENV is production.
# STRAVA_MOCK=1

# Optional. Until this is set, activity analysis uses TanStack AI tools with a mocked model reply.
OPENROUTER_API_KEY=

# Logging. APP_ENV defaults to NODE_ENV. Without LOKI_HOST, logs go to the console.
# staging serves an orange favicon so tabs are distinct from production.
APP_ENV=development
# LOKI_HOST=http://localhost:3100
