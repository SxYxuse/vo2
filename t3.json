{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup",
      "command": "bun install --frozen-lockfile && bun scripts/worktree-setup.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "bun run db:up && bun run dev",
      "icon": "play"
    },
    {
      "name": "Build",
      "command": "bun run build",
      "icon": "build"
    }
  ]
}
